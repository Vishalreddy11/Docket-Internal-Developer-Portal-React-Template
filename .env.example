# ============================================================
# Docket React Template — dev-only env overrides.
#
# ANYTHING WITH `VITE_` PREFIX SHIPS TO THE BROWSER — do NOT put
# secrets here. Treat this file as publicly readable.
#
# Runtime config for the container image lives in
# public/config/runtime-config.json (loaded at boot). Env vars
# below only affect the local dev server; the built image reads
# runtime-config.json from /config/runtime-config.json served by
# nginx.
# ============================================================

# --- Auth mode ---
# oidc  — production default; uses react-oidc-context against your IdP
# mock  — local dev only; skip login, inject a fake user
# none  — no auth at all (public app); remove <ProtectedRoute> too
VITE_AUTH_MODE=mock

# --- OIDC (only used when VITE_AUTH_MODE=oidc) ---
# These MIRROR the runtime-config.json shape; dev env overrides ship values.
VITE_OIDC_ISSUER=https://identity.your-company.example/
VITE_OIDC_CLIENT_ID=docket-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_SCOPES=openid profile email

# --- API base URL (leave empty; the developer wires their own backend) ---
# Same-origin `/api` is a good default IF you serve the SPA behind the same
# ingress as the backend. Cross-origin needs CORS on the backend.
VITE_API_BASE_URL=
